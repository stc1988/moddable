{
	"include": [
		"$(MODDABLE)/modules/io/manifest.json",
		"$(MODDABLE)/modules/crypt/digest/manifest.json",
		"$(MODDABLE)/modules/data/text/encoder/manifest.json"
	],
	"modules": {
		"*": [ 
			"$(MODULES)/network/dns/moddnsparser"
		],
		"embedded:network/http/server": "./httpserver",
		"httpserver/config": "./config",
		"embedded:network/http/server/route/serversentevents": "./options/serversentevents",
		"embedded:network/http/server/route/webpage": "./options/webpage",
		"embedded:network/http/server/route/ws/handshake": "./options/websocket"
	},
	"preload": [
		"embedded:network/http/server",
		"httpserver/config",
		"embedded:network/http/server/route/serversentevents",
		"embedded:network/http/server/route/webpage",
		"embedded:network/http/server/route/ws/handshake"
	],
	"mcpack": true
}
