{
	"modules": {
		"*": "$(MODULES)/io/common/builtinCommon"
	},
	"platforms": {
		"esp32": {
			"include": "./esp32/manifest.json",
			"dependency": [
				{ "idf": "esp_wifi" }
			]
		},
		"esp": {
			"include": "./esp/manifest.json"
		},
		"pico": {
			"include": "./pico/manifest.json"
		},
		"zephyr": {
			"include": "./zephyr/manifest.json"
		},
		"mac": {
			"include": "./sim/manifest.json"
		},
		"lin": {
			"include": "./sim/manifest.json"
		},
		"win": {
			"include": "./sim/manifest.json"
		},
		"...": {
			"error": "ECMA-419 Wi-Fi unsupported target"
		}
	}
}
