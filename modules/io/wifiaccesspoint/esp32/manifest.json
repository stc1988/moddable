{
	"platforms": {
		"esp32": {
			"modules": {
				"embedded:network/interface/wifi/accesspoint": "./wifiaccesspoint-esp32"
			},
			"preload": [
				"embedded:network/interface/wifi/accesspoint"
			],
			"dependency": [
				{ "idf": "esp_wifi" }
			],
			"esp32Config": {
				"CONFIG_ESP_WIFI_SOFTAP_SUPPORT": "y",
				"CONFIG_LWIP_DHCPS": "y"
			}
		}
	}
}
